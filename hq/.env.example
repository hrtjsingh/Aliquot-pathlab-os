# HQ talks to the online master (Neon) by default via CLOUD_DATABASE_URL
# from the parent .env. Override with HQ_DATABASE_URL to use local Postgres.
# HQ_DATABASE_URL="postgresql://USER@127.0.0.1:5433/pathlab?schema=public"
# CLOUD_DATABASE_URL="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require"

# Optional overrides. Keys are generated into hq/.data on first start.
# HQ_API_PORT=8787
# HQ_ORIGIN="http://127.0.0.1:5174"
# HQ_SESSION_SECRET="replace-me"
# LICENSE_PRIVATE_KEY=
# LICENSE_PUBLIC_KEY=
