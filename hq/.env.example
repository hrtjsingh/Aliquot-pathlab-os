# HQ database target. Prefer CLOUD_DATABASE_URL (Neon master) by default.
# Switch in the UI (Cloud / Local), or set:
# HQ_DB_TARGET=cloud
# HQ_DB_TARGET=local
#
# URLs are loaded from the parent repo .env (and optional hq/.env overrides).
# CLOUD_DATABASE_URL="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require"
# DATABASE_URL="postgresql://USER@127.0.0.1:5433/pathlab?schema=public"
# HQ_DATABASE_URL=  # optional local override for HQ only

# Optional overrides. Keys are generated into hq/.data on first start.
# HQ_API_PORT=8787
# HQ_ORIGIN="http://127.0.0.1:5174"
# HQ_SESSION_SECRET="replace-me"
# LICENSE_PRIVATE_KEY=
# LICENSE_PUBLIC_KEY=
