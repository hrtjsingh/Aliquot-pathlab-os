// ============================================================================
// Pathology Lab LIMS — core data model
// Postgres via Prisma. Every clinically/legally significant table carries
// createdAt/updatedAt and is written through the AuditLog (see lib/audit.ts) —
// never edit result or report rows outside the app layer.
// ============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// One independent lab company. Branches, users, patients, and catalogs never cross vendors.
model Vendor {
  id             String   @id @default(cuid())
  slug           String   @unique
  name           String
  logoUrl        String?
  primaryColor   String?
  letterheadUrl  String?
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  users          User[]
  branches       Branch[]
  patients       Patient[]
  tests          Test[]
  panels         Panel[]
  orders         Order[]
  reportTemplates ReportTemplate[]
  auditLogs      AuditLog[]
  syncState      SyncState?
  tombstones     Tombstone[]
  subscription   Subscription?
  licenseCache   LicenseCache?
}

model SyncState {
  id           String    @id @default(cuid())
  vendorId     String    @unique
  vendor       Vendor    @relation(fields: [vendorId], references: [id])
  lastPushedAt DateTime?
  lastPulledAt DateTime?
  lastError    String?
  updatedAt    DateTime  @updatedAt
}

model Tombstone {
  id         String   @id @default(cuid())
  vendorId   String
  vendor     Vendor   @relation(fields: [vendorId], references: [id])
  entityType String
  entityId   String
  deletedAt  DateTime @default(now())

  @@unique([vendorId, entityType, entityId])
  @@index([vendorId, deletedAt])
}

// ---------------------------------------------------------------------------
// HQ billing — Neon (CLOUD_DATABASE_URL) is the master. Local Subscription
// rows are not authority. Labs only cache a signed lease (LicenseCache);
// expiry and status come from the Ed25519 payload, so editing local SQL
// cannot extend access.
// ---------------------------------------------------------------------------

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  SUSPENDED
  CANCELLED
}

model SuperAdmin {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

/// HQ publishes its Ed25519 public key here so Vercel / labs can verify leases
/// without shipping `.license-public.pem` (gitignored).
model LicenseAuthority {
  id           String   @id @default("hq")
  publicKeyPem String   @db.Text
  updatedAt    DateTime @updatedAt
  createdAt    DateTime @default(now())
}

model Plan {
  id             String   @id @default(cuid())
  code           String   @unique
  name           String
  seats          Int      @default(1)
  intervalMonths Int      @default(12)
  intervalDays   Int      @default(0)
  priceInr       Decimal? @db.Decimal(12, 2)
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  subscriptions  Subscription[]
}

model Subscription {
  id           String             @id @default(cuid())
  vendorId     String             @unique
  vendor       Vendor             @relation(fields: [vendorId], references: [id])
  planId       String
  plan         Plan               @relation(fields: [planId], references: [id])
  status       SubscriptionStatus @default(TRIAL)
  seats        Int                @default(5)
  startsAt     DateTime           @default(now())
  expiresAt    DateTime
  signedLease  String             @db.Text
  notes        String?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  billingEvents BillingEvent[]

  @@index([status, expiresAt])
}

model BillingEvent {
  id             String       @id @default(cuid())
  subscriptionId String
  subscription   Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  kind           String
  amountInr      Decimal?     @db.Decimal(12, 2)
  note           String?
  actorEmail     String?
  createdAt      DateTime     @default(now())

  @@index([subscriptionId, createdAt])
}

/// Local cache of the HQ-signed lease only. Never treat unsigned columns as truth.
model LicenseCache {
  id          String   @id @default(cuid())
  vendorId    String   @unique
  vendor      Vendor   @relation(fields: [vendorId], references: [id])
  signedLease String   @db.Text
  expiresAt   DateTime
  source      String   @default("cloud")
  verifiedAt  DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Identity / RBAC
// ---------------------------------------------------------------------------

enum Role {
  ADMIN // full config + user management
  FRONTDESK // registration, billing, sample collection
  PHLEBOTOMIST // sample collection / accession
  TECHNOLOGIST // result entry, technical verification
  PATHOLOGIST // authorization, histopath/cytology diagnosis, amendments
  BRANCH_MANAGER // cross-branch reporting, no result authority
}

model User {
  id            String   @id @default(cuid())
  vendorId      String
  vendor        Vendor   @relation(fields: [vendorId], references: [id])
  name          String
  email         String
  passwordHash  String
  role          Role
  branchId      String?
  branch        Branch?  @relation(fields: [branchId], references: [id])
  signatureUrl  String? // stored digital signature image for report footer
  registrationNo String? // pathologist council registration number
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  resultsEntered   Result[]        @relation("EnteredBy")
  resultsVerified  Result[]        @relation("VerifiedBy")
  ordersAuthorized Order[]         @relation("AuthorizedBy")
  auditLogs        AuditLog[]
  criticalCalls    CriticalValueCall[]

  @@unique([vendorId, email])
  @@index([vendorId])
}

model Branch {
  id           String   @id @default(cuid())
  vendorId     String
  vendor       Vendor   @relation(fields: [vendorId], references: [id])
  name         String
  code         String
  address      String?
  letterheadUrl String?
  nablNo       String?
  isoNo        String?
  inrIsi       Float    @default(1.0) // reagent-lot ISI for INR = (PT / mean PT) ^ ISI
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  users        User[]
  orders       Order[]
  reportTemplates ReportTemplate[]

  @@unique([vendorId, code])
  @@index([vendorId])
}

// ---------------------------------------------------------------------------
// Patient master
// ---------------------------------------------------------------------------

enum Gender {
  MALE
  FEMALE
  OTHER
}

model Patient {
  id            String   @id @default(cuid())
  vendorId      String
  vendor        Vendor   @relation(fields: [vendorId], references: [id])
  mrn           String
  firstName     String
  lastName      String?
  dob           DateTime?
  ageYears      Int? // used when DOB unknown, entered directly at registration
  ageMonths     Int? // for infants
  gender        Gender
  isPregnant    Boolean  @default(false)
  pregnancyWeeks Int?
  phone         String?
  email         String?
  address       String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  orders        Order[]

  @@unique([vendorId, mrn])
  @@index([vendorId])
}

// ---------------------------------------------------------------------------
// Test master, reference ranges, panels
// ---------------------------------------------------------------------------

enum TestCategory {
  HEMATOLOGY
  CLINICAL_CHEMISTRY
  MICROBIOLOGY
  SEROLOGY_IMMUNOLOGY
  COAGULATION
  URINALYSIS
  HISTOPATHOLOGY
  CYTOLOGY
  MOLECULAR
  ENDOCRINE
  OTHER
}

enum ResultDataType {
  NUMERIC
  TEXT // free text (histopath, culture organism name)
  QUALITATIVE // Positive/Negative/Detected/Not Detected/Reactive...
  SEMI_QUANTITATIVE // e.g. 1+ / 2+ / 3+, urine dipstick
  ORGANISM_PANEL // microbiology C&S structured result
}

model Test {
  id              String   @id @default(cuid())
  vendorId        String
  vendor          Vendor   @relation(fields: [vendorId], references: [id])
  code            String
  name            String
  shortName       String?
  category        TestCategory
  specimenType    String // Serum, Whole Blood EDTA, Urine, etc.
  method          String?
  loincCode       String?
  unit            String? // default/conventional unit
  altUnit         String? // SI unit, if different
  unitConversionFactor Float? // multiply conventional value by this to get altUnit
  decimalPrecision Int     @default(2)
  dataType        ResultDataType @default(NUMERIC)
  turnaroundHours Int?    // expected TAT, used for worklist SLA flags
  price           Decimal? @db.Decimal(10, 2)
  isDerived       Boolean  @default(false) // computed by the calc engine, not entered
  derivationRule  String? // key into lib/calc-engine.ts rule registry
  sortOrder       Int      @default(0) // catalog / report sequence within the lab
  hideOnBooking   Boolean  @default(false) // book via package/group, hide on a-la-carte booking
  autoVerifyEligible Boolean @default(false) // can auto-release if in-range & no delta flag
  description     String? // clinical profile: what the test measures and when it is used
  collectionNotes String? // fasting, tube type, handling
  active          Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  referenceRanges ReferenceRange[]
  panelTests      PanelTest[]
  orderTests      OrderTest[]
  results         Result[]
  criticalThresholds CriticalThreshold[]

  @@unique([vendorId, code])
  @@index([vendorId])
  @@index([vendorId, sortOrder])
}

// Reference ranges resolve by test + age band + gender + (optional) condition.
// Resolution order in lib/reference-range.ts: exact age+gender+pregnancy match
// -> age+gender match -> gender-only match -> default adult fallback.
model ReferenceRange {
  id            String   @id @default(cuid())
  testId        String
  test          Test     @relation(fields: [testId], references: [id])
  gender        Gender? // null = applies to all genders
  ageMinDays    Int      @default(0)
  ageMaxDays    Int      @default(43800) // ~120 years, effectively "no upper bound"
  pregnancyOnly Boolean  @default(false)
  trimester     Int? // 1, 2, 3 — only relevant if pregnancyOnly
  low           Float?
  high          Float?
  textRange     String? // for qualitative tests, e.g. "Non-reactive"
  unit          String?
  isDefault     Boolean  @default(false) // fallback range if nothing else matches
  createdAt     DateTime @default(now())

  @@index([testId])
}

// Panic/critical thresholds are separate from the normal H/L reference range
// and trigger the critical-value call workflow, not just a flag.
model CriticalThreshold {
  id       String  @id @default(cuid())
  testId   String
  test     Test    @relation(fields: [testId], references: [id])
  low      Float?
  high     Float?
  gender   Gender?
  ageMinDays Int   @default(0)
  ageMaxDays Int   @default(43800)

  @@index([testId])
}

model Panel {
  id          String   @id @default(cuid())
  vendorId    String
  vendor      Vendor   @relation(fields: [vendorId], references: [id])
  code        String
  name        String // e.g. "Complete Blood Count (CBC)"
  category    TestCategory
  price       Decimal? @db.Decimal(10, 2)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  panelTests  PanelTest[]
  orderPanels OrderPanel[]

  @@unique([vendorId, code])
  @@index([vendorId])
}

model PanelTest {
  id       String @id @default(cuid())
  panelId  String
  panel    Panel  @relation(fields: [panelId], references: [id])
  testId   String
  test     Test   @relation(fields: [testId], references: [id])
  sortOrder Int   @default(0) // fixed report print order, not alphabetical

  @@unique([panelId, testId])
}

// ---------------------------------------------------------------------------
// Orders / Accession / Workflow
// ---------------------------------------------------------------------------

enum OrderPriority {
  ROUTINE
  URGENT
  STAT
}

enum OrderStatus {
  ORDER_CREATED
  SAMPLE_COLLECTED
  SAMPLE_RECEIVED
  RESULT_ENTRY
  TECH_VERIFIED
  AUTHORIZED
  RELEASED
  SENT_TO_CUSTOMER
  COLLECTED_BY_CUSTOMER
  AMENDED
  CANCELLED
}

model Order {
  id              String   @id @default(cuid())
  vendorId        String
  vendor          Vendor   @relation(fields: [vendorId], references: [id])
  accessionNo     String
  patientId       String
  patient         Patient  @relation(fields: [patientId], references: [id])
  branchId        String
  branch          Branch   @relation(fields: [branchId], references: [id])
  referringDoctor String?
  priority        OrderPriority @default(ROUTINE)
  status          OrderStatus   @default(ORDER_CREATED)
  totalCharge     Decimal  @default(0) @db.Decimal(10, 2)
  discount        Decimal  @default(0) @db.Decimal(10, 2)
  amountPaid      Decimal  @default(0) @db.Decimal(10, 2)

  collectedAt     DateTime?
  receivedAt      DateTime?
  reportedAt      DateTime?

  authorizedById  String?
  authorizedBy    User?    @relation("AuthorizedBy", fields: [authorizedById], references: [id])

  isAmendment     Boolean  @default(false)
  amendsOrderId   String?  @unique
  amendsOrder     Order?   @relation("Amendment", fields: [amendsOrderId], references: [id])
  amendedBy       Order?   @relation("Amendment")
  amendReasonCode String?

  // Unguessable token for the public QR view/download page (/r/{token}).
  publicToken     String?  @unique

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  orderTests      OrderTest[]
  orderPanels     OrderPanel[]
  results         Result[]
  auditLogs       AuditLog[]
  criticalCalls   CriticalValueCall[]
  deliveries      ReportDelivery[]

  @@unique([vendorId, accessionNo])
  @@index([patientId])
  @@index([status])
  @@index([vendorId, status])
}

model OrderPanel {
  id      String @id @default(cuid())
  orderId String
  order   Order  @relation(fields: [orderId], references: [id])
  panelId String
  panel   Panel  @relation(fields: [panelId], references: [id])
}

model OrderTest {
  id        String @id @default(cuid())
  orderId   String
  order     Order  @relation(fields: [orderId], references: [id])
  testId    String
  test      Test   @relation(fields: [testId], references: [id])
  sortOrder Int    @default(0) // snapshot of print/entry sequence at booking

  @@unique([orderId, testId])
}

// ---------------------------------------------------------------------------
// Results
// ---------------------------------------------------------------------------

enum ResultFlag {
  NORMAL
  LOW
  HIGH
  CRITICAL_LOW
  CRITICAL_HIGH
  ABNORMAL // qualitative abnormal (e.g. Reactive) without numeric direction
}

enum ResultStatus {
  PENDING
  ENTERED
  TECH_VERIFIED
  AUTHORIZED
  RELEASED
  AMENDED
}

model Result {
  id              String   @id @default(cuid())
  orderId         String
  order           Order    @relation(fields: [orderId], references: [id])
  testId          String
  test            Test     @relation(fields: [testId], references: [id])

  numericValue    Float?
  textValue       String?
  unit            String?

  referenceRangeText String? // resolved + snapshotted at time of entry/verification
  flag            ResultFlag @default(NORMAL)
  deltaFlag       Boolean  @default(false)
  deltaPrevValue  Float?
  deltaPctChange  Float?

  isDerived       Boolean  @default(false)
  status          ResultStatus @default(PENDING)

  instrumentId    String? // set when result came via HL7/ASTM interface, null = manual entry
  enteredById     String?
  enteredBy       User?    @relation("EnteredBy", fields: [enteredById], references: [id])
  enteredAt       DateTime?

  verifiedById    String?
  verifiedBy      User?    @relation("VerifiedBy", fields: [verifiedById], references: [id])
  verifiedAt      DateTime?

  interpretiveComment String? // auto-populated, pathologist-editable
  pathologistNote String?

  // Histopath/Cytology narrative fields — used instead of numericValue/textValue
  grossDescription String?
  microscopicDescription String?
  diagnosis       String?

  // Microbiology culture & sensitivity — structured as JSON:
  // { organism: string, colonyCount: string, antibiotics: [{ drug, result: "S"|"I"|"R" }] }
  organismPanel   Json?

  // Molecular
  ctValue         Float?
  qualitativeResult String? // Detected / Not Detected

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([orderId])
  @@index([testId])
  @@index([status])
}

// Critical value call-back log — required whenever a result crosses a
// CriticalThreshold. Compliance requires who was called, when, and by whom.
model CriticalValueCall {
  id            String   @id @default(cuid())
  orderId       String
  order         Order    @relation(fields: [orderId], references: [id])
  calledById    String
  calledBy      User     @relation(fields: [calledById], references: [id])
  notifiedName  String // clinician/nurse notified
  notifiedRole  String?
  contactMethod String // phone, in-person, etc.
  calledAt      DateTime @default(now())
  confirmationNote String?
}

// ---------------------------------------------------------------------------
// Report templates & delivery
// ---------------------------------------------------------------------------

model ReportTemplate {
  id          String   @id @default(cuid())
  vendorId    String
  vendor      Vendor   @relation(fields: [vendorId], references: [id])
  branchId    String?
  branch      Branch?  @relation(fields: [branchId], references: [id])
  name        String
  category    TestCategory?
  layoutJson  Json // section order, header/footer config, language
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([vendorId])
}

enum DeliveryChannel {
  EMAIL
  SMS
  WHATSAPP
  PORTAL
  PRINT
}

enum DeliveryStatus {
  QUEUED
  SENT
  FAILED
  VIEWED
}

model ReportDelivery {
  id        String   @id @default(cuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id])
  channel   DeliveryChannel
  status    DeliveryStatus @default(QUEUED)
  target    String // email address / phone number
  sentAt    DateTime?
  errorMessage String?
  createdAt DateTime @default(now())
}

// ---------------------------------------------------------------------------
// Audit trail — every create/edit/verify/authorize/print/amend action
// ---------------------------------------------------------------------------

model AuditLog {
  id          String   @id @default(cuid())
  vendorId    String?
  vendor      Vendor?  @relation(fields: [vendorId], references: [id])
  userId      String?
  user        User?    @relation(fields: [userId], references: [id])
  orderId     String?
  order       Order?   @relation(fields: [orderId], references: [id])
  action      String // e.g. "RESULT_ENTERED", "ORDER_AUTHORIZED", "REPORT_PRINTED"
  entityType  String
  entityId    String?
  beforeJson  Json?
  afterJson   Json?
  ipAddress   String?
  createdAt   DateTime @default(now())

  @@index([orderId])
  @@index([userId])
  @@index([vendorId])
}
