# Dev default: project-local Postgres on 5433 (`npm run db:up`).
# The app reads and writes this database. Keep it on the lab server PC.
DATABASE_URL="postgresql://hartej@127.0.0.1:5433/pathlab?schema=public"
AUTH_SECRET="replace-with-openssl-rand-base64-32"
AUTH_TRUST_HOST="true"

# Neon (or another hosted Postgres) used only when Sync runs and the internet is up.
# Apply the same Prisma migrations here: `npm run db:migrate:cloud`
# CLOUD_DATABASE_URL="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require"

# Public origin printed into report QR codes and WhatsApp report links
# (phone cameras cannot reach localhost).
# Example on a LAN: APP_URL="http://192.168.1.10:3000"
# APP_URL="https://reports.example.com"

# Public half of the HQ Ed25519 license key.
# Local: HQ writes `.license-public.pem` on first start.
# Vercel / Neon: HQ also publishes the key into the `LicenseAuthority` table when
# it seeds against CLOUD_DATABASE_URL (or DATABASE_URL). Optional override:
# LICENSE_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\\n...\\n-----END PUBLIC KEY-----"
#
# After deploy: `npm run db:migrate:cloud` then start HQ once with Cloud env so
# Neon gets LicenseAuthority + signed leases for each lab.

# System Postgres on 5432 (after creating a role matching your OS user):
#   sudo -u postgres createuser -s "$USER"
#   sudo -u postgres createdb -O "$USER" pathlab
# DATABASE_URL="postgresql://USER@localhost/pathlab?host=/var/run/postgresql&schema=public"
